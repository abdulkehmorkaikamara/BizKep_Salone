{
  "name": "bizkepsalone",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
